    "verify": "pnpm lint && pnpm typecheck && pnpm format:check",
    "verify:base": "node scripts/verify-base.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.6",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
